# RSVP contact addresses (private — never commit the real ones).
# Copy this file to .env and fill in your addresses for local development.
# For production builds, pass these as secrets/CI env vars (Vite inlines them at build time).
# Note: mailto addresses are visible on the live site to anyone who inspects it — only git history is protected.

VITE_RSVP_EMAIL=you@example.com
VITE_RSVP_CC=partner@example.com

# Google Maps Embed API key (public, restricted to your site's referrers).
# Leave empty to fall back to the "Get Directions" link only (no map shown).
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_KEY=

# Production origin for the guest gate (used by the blocked state's invite-code
# field to redirect to the real domain, and by the token/QR scripts).
# Keep the trailing slashes off. Example:
VITE_SITE_URL=

# Set to "true" to enable the downloadable photo album (zip) for guests.
# Guests can upload and view photos regardless — only the album download is
# gated by this flag. Controlled via the GitHub Actions secret GALLERY_ENABLED,
# which is also pushed to the Worker (guarding /api/album).
VITE_GALLERY_ENABLED=

# Set to "true" to show the gift section, the gift list dialog, and the
# "thinking about a gift?" prompt. The Worker needs the GIFTS R2 binding and a
# published registry (npm run gifts:upload) or the list stays empty.
VITE_GIFTS_ENABLED=

# Shared secret for the gift registry admin route (POST /api/gifts/admin).
# Generate with: openssl rand -hex 32
# Store it HERE (.env.local, NOT committed) AND as the Cloudflare Worker secret
# "GIFT_ADMIN_SECRET" (npx wrangler secret put GIFT_ADMIN_SECRET --config worker/wrangler.toml).
# `npm run gifts:upload` sends it to publish resources/gifts.json.
GIFT_ADMIN_SECRET=

# Secret for signing/verifying guest magic-link tokens.
# Generate with: openssl rand -hex 32
# Store it HERE (.env.local, NOT committed) AND as the Cloudflare Worker secret
# "TOKEN_SECRET" (npx wrangler secret put TOKEN_SECRET --config worker/wrangler.toml).
# The same value is pushed to the Worker from GitHub Actions via the TOKEN_SECRET repo secret.
TOKEN_SECRET=