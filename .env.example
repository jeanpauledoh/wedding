# RSVP contact addresses (private — never commit the real ones).
# Copy this file to .env and fill in your addresses for local development.
# For production builds, pass these as secrets/CI env vars (Vite inlines them at build time).
# Note: mailto addresses are visible on the live site to anyone who inspects it — only git history is protected.

VITE_RSVP_EMAIL=you@example.com
VITE_RSVP_CC=partner@example.com

# Google Maps Embed API key (public, restricted to your site's referrers).
# Leave empty to fall back to the "Get Directions" link only (no map shown).
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_KEY=