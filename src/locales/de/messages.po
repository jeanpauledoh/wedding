msgstr "'Sag mir wo die Blumen sind'"

#: src/components/Details.tsx
msgid "10:45 — registry office in Berlin Mitte"
msgstr "10:45 Uhr — Standesamt in Berlin Mitte"

#: src/components/Details.tsx
msgid "12:30 — brunch with sparkling wine"
msgstr "12:30 Uhr — Brunch mit Sekt"

#: src/components/Footer.tsx
